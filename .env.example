# Sao chép file này thành .env rồi điền giá trị:  cp .env.example .env
# Lưu ý: Vite chỉ nạp biến có tiền tố VITE_ và nướng thẳng vào bundle lúc build
# -> mọi giá trị ở đây đều PUBLIC. Không bao giờ đặt secret thật vào đây.

# URL gốc của API backend.
# Dev: để "/api" và dùng proxy trong vite.config.js (tránh CORS + mixed content).
# Production: URL đầy đủ của backend, ví dụ https://api.example.com/api
VITE_API_URL=/api

# Google Sign-In — Client ID (loại Web) từ Google Cloud Console.
# Phải khớp GOOGLE_CLIENT_ID phía backend. Để trống = ẩn nút đăng nhập Google.
VITE_GOOGLE_CLIENT_ID=

# Khoá cho màn hình kiosk ở cổng ra/vào (gửi qua header X-Kiosk-Key).
# Phải khớp KIOSK_API_KEY phía backend. Chỉ cần khi chạy route /kiosk.
VITE_KIOSK_KEY=
